@page
@model Share.Web.Pages.Hosts.IndexModel
@using Share.Web.Pages.Shared
@{ ViewData["Title"] = "Hosts"; }
<h1 class="govuk-heading-l">Hosts</h1>
<p class="govuk-body">A host is the person a guest lives with. Often the sponsor, but not always.</p>
@if (Model.People.Count == 0)
{
    <p class="govuk-body">No hosts yet. Process a data file from the <a class="govuk-link" href="/Admin">demo controls</a>.</p>
}
else
{
    <partial name="_PeopleTable" model="new PeopleTable(Model.People, PersonRole.Host)" />
}
