@page
@model Share.Web.Pages.Guests.IndexModel
@{ ViewData["Title"] = "Guests"; }
<h1 class="govuk-heading-l">Guests</h1>
@if (Model.Guests.Count == 0)
{
    <p class="govuk-body">No guests yet. Process a data file from the <a class="govuk-link" href="/Admin">demo controls</a>.</p>
}
else
{
    <div class="app-table-wrapper" tabindex="0" role="region" aria-labelledby="guests-caption">
    <table class="govuk-table">
        <caption id="guests-caption" class="govuk-table__caption govuk-table__caption--m">@Model.Guests.Count guest@(Model.Guests.Count == 1 ? "" : "s")</caption>
        <thead class="govuk-table__head">
            <tr class="govuk-table__row">
                <th scope="col" class="govuk-table__header">Name</th>
                <th scope="col" class="govuk-table__header">Date of birth</th>
                <th scope="col" class="govuk-table__header">Visa application</th>
                <th scope="col" class="govuk-table__header">Sponsor</th>
                <th scope="col" class="govuk-table__header">Council</th>
            </tr>
        </thead>
        <tbody class="govuk-table__body">
            @foreach (var g in Model.Guests)
            {
                var app = g.VisaApplication!;
                <tr class="govuk-table__row">
                    <td class="govuk-table__cell"><a class="govuk-link" href="/Guests/@g.Id">@g.FullName</a></td>
                    <td class="govuk-table__cell">@Display.Date(g.DateOfBirth)</td>
                    <td class="govuk-table__cell"><a class="govuk-link" href="/Applications/@app.Id">@app.Uan</a></td>
                    <td class="govuk-table__cell">
                        @if (app.Sponsor is { } s) { <a class="govuk-link" href="/People/@s.Id">@s.FullName</a> } else { @:Not given
                        }
                    </td>
                    <td class="govuk-table__cell">@Display.Council(app.Council)</td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}
