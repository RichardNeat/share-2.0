@page
@model IndexModel
@{ ViewData["Title"] = "Home"; }

@if (Model.Announcements.Count > 0)
{
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-full">
            <div class="govuk-!-margin-bottom-6">
                <h2 class="govuk-heading-m">Announcements</h2>
                @foreach (var announcement in Model.Announcements)
                {
                    <div class="govuk-notification-banner govuk-notification-banner--success" role="region" aria-labelledby="announcement-@announcement.Id">
                        <div class="govuk-notification-banner__header">
                            <h3 class="govuk-notification-banner__title" id="announcement-@announcement.Id">
                                @announcement.Title
                            </h3>
                        </div>
                        <div class="govuk-notification-banner__content">
                            <p class="govuk-body">@announcement.Body</p>
                            @if (!string.IsNullOrEmpty(announcement.Link))
                            {
                                <p class="govuk-body">
                                    <a href="@announcement.Link" class="govuk-notification-banner__link">More information</a>
                                </p>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <h1 class="govuk-heading-xl">The Share</h1>
        <p class="govuk-body-l">Casework for the Homes for Ukraine programme. Visa applications arrive as files, and councils work them through to safe arrival.</p>
        <ul class="govuk-list">
            <li><a class="govuk-link" href="/Cases">Cases</a> (@Model.CaseCount)</li>
            <li><a class="govuk-link" href="/Applications">Visa applications</a> (@Model.ApplicationCount)</li>
            <li><a class="govuk-link" href="/Guests">Guests</a> (@Model.GuestCount)</li>
            <li><a class="govuk-link" href="/Sponsors">Sponsors</a> (@Model.SponsorCount)</li>
            <li><a class="govuk-link" href="/Hosts">Hosts</a> (@Model.HostCount)</li>
            <li><a class="govuk-link" href="/Accommodations">Accommodations</a> (@Model.AccommodationCount)</li>
            <li><a class="govuk-link" href="/Admin">Demo controls</a>: process the next data file or reset the demo</li>
        </ul>
    </div>
</div>
