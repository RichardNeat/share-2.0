@inject Share.Web.Users.CurrentUser CurrentUser
@{
    var signedInAs = CurrentUser.User;
    var path = Context.Request.Path.Value ?? "/";
    bool Active(string prefix) => path.StartsWith(prefix, StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="en" class="govuk-template">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0b0c0c" />
    <title>@ViewData["Title"] - The Share - GOV.UK</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/govuk-frontend@5/dist/govuk/govuk-frontend.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="govuk-template__body">
    <script>document.body.className += ' js-enabled' + ('noModule' in HTMLScriptElement.prototype ? ' govuk-frontend-supported' : '');</script>
    <a href="#main-content" class="govuk-skip-link" data-module="govuk-skip-link">Skip to main content</a>

    <header class="govuk-header govuk-header--full-width-border app-header" data-module="govuk-header">
        <div class="govuk-header__container govuk-width-container app-header__container">
            <a href="/" class="govuk-header__link govuk-header__link--homepage app-header__brand">
                <img src="~/images/the-share-logo.png" alt="" class="app-header__logo" width="88" height="88" />
                <span class="app-header__text">
                    <span class="app-header__name">The Share</span>
                    <span class="app-header__tagline">Homes for Ukraine casework</span>
                </span>
            </a>
        </div>
    </header>
    <section aria-label="Service information" class="govuk-service-navigation" data-module="govuk-service-navigation">
        <div class="govuk-width-container">
            <div class="govuk-service-navigation__container">
                <nav aria-label="Menu" class="govuk-service-navigation__wrapper">
                    <button type="button" class="govuk-service-navigation__toggle govuk-js-service-navigation-toggle" aria-controls="navigation" hidden>Menu</button>
                    <ul class="govuk-service-navigation__list" id="navigation">
                        <li class="govuk-service-navigation__item @(Active("/Applications") ? "govuk-service-navigation__item--active" : "")">
                            <a class="govuk-service-navigation__link" href="/Applications" @(Active("/Applications") ? "aria-current=page" : "")>Applications</a>
                        </li>
                        <li class="govuk-service-navigation__item @(Active("/Guests") ? "govuk-service-navigation__item--active" : "")">
                            <a class="govuk-service-navigation__link" href="/Guests" @(Active("/Guests") ? "aria-current=page" : "")>Guests</a>
                        </li>
                        <li class="govuk-service-navigation__item @(Active("/Sponsors") ? "govuk-service-navigation__item--active" : "")">
                            <a class="govuk-service-navigation__link" href="/Sponsors" @(Active("/Sponsors") ? "aria-current=page" : "")>Sponsors</a>
                        </li>
                        <li class="govuk-service-navigation__item @(Active("/Hosts") ? "govuk-service-navigation__item--active" : "")">
                            <a class="govuk-service-navigation__link" href="/Hosts" @(Active("/Hosts") ? "aria-current=page" : "")>Hosts</a>
                        </li>
                        <li class="govuk-service-navigation__item @(Active("/Accommodations") ? "govuk-service-navigation__item--active" : "")">
                            <a class="govuk-service-navigation__link" href="/Accommodations" @(Active("/Accommodations") ? "aria-current=page" : "")>Accommodations</a>
                        </li>
                        <li class="govuk-service-navigation__item @(Active("/Admin") ? "govuk-service-navigation__item--active" : "")">
                            <a class="govuk-service-navigation__link" href="/Admin" @(Active("/Admin") ? "aria-current=page" : "")>Demo controls</a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    </section>

    <div class="govuk-width-container">
        <div class="govuk-phase-banner">
            <p class="govuk-phase-banner__content">
                <strong class="govuk-tag govuk-phase-banner__content__tag">Alpha</strong>
                <span class="govuk-phase-banner__text">This is a hackathon rebuild. All data is synthetic.</span>
            </p>
        </div>
        <p class="govuk-body-s app-signed-in" id="signed-in-as">
            Signed in as <strong>@signedInAs.Name</strong>
            <strong class="govuk-tag @(signedInAs.IsAdmin ? "govuk-tag--purple" : "govuk-tag--turquoise")">@(signedInAs.IsAdmin ? "All councils" : Display.Council(signedInAs.Council))</strong>
            <a class="govuk-link app-signed-in__change" href="/Admin#user">Change user<span class="govuk-visually-hidden"> (demo controls)</span></a>
        </p>
        @await RenderSectionAsync("BeforeContent", required: false)
        <main class="govuk-main-wrapper" id="main-content">
            @RenderBody()
        </main>
    </div>

    <footer class="govuk-footer">
        <div class="govuk-width-container">
            <div class="govuk-footer__meta">
                <div class="govuk-footer__meta-item govuk-footer__meta-item--grow">
                    <p class="govuk-body-s govuk-!-margin-bottom-0">Homes for Ukraine casework. Hackathon 2026. Every name and record is invented.</p>
                </div>
            </div>
        </div>
    </footer>
    <script type="module">
        import { initAll } from 'https://cdn.jsdelivr.net/npm/govuk-frontend@5/dist/govuk/govuk-frontend.min.js';
        initAll();
    </script>
</body>
</html>
