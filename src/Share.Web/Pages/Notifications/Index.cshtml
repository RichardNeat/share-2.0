@page
@model Share.Web.Pages.Notifications.IndexModel
@{
    ViewData["Title"] = "Notifications - The Share - GOV.UK";
}

<main id="main-content" class="govuk-main-wrapper">
    <div class="govuk-width-container">
        <h1 class="govuk-heading-l">Notifications</h1>

        @if (Model.UnreadCount > 0)
        {
            <div class="govuk-notification-banner" role="region" aria-labelledby="govuk-notification-banner-title">
                <div class="govuk-notification-banner__header">
                    <h2 class="govuk-notification-banner__title" id="govuk-notification-banner-title">
                        You have @Model.UnreadCount unread notification@(Model.UnreadCount != 1 ? "s" : "")
                    </h2>
                </div>
            </div>

            <form method="post" asp-page-handler="MarkAllAsRead" class="govuk-!-margin-bottom-6">
                <button type="submit" class="govuk-button govuk-button--secondary">Mark all as read</button>
            </form>
        }

        @if (Model.Notifications.Count == 0)
        {
            <p class="govuk-body">You have no notifications.</p>
        }
        else
        {
            <div class="govuk-!-margin-top-6">
                <h2 class="govuk-heading-m">All notifications</h2>

                <!-- TODO: Render notification list with GOV.UK styling -->
                <!-- Each notification should show:
                     - Title and description
                     - Event type as a tag
                     - Relative time (e.g., "2 hours ago")
                     - Unread indicator
                     - Link to related record if available
                     - Mark as read action
                -->
            </div>
        }
    </div>
</main>
