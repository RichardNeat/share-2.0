@page "/Cases/{id:int}"
@model Share.Web.Pages.Cases.DetailsModel
@{
    var c = Model.Case;
    var guests = c.Guests.ToList();
    var youngest = guests.Where(g => g.DateOfBirth != null).MaxBy(g => g.DateOfBirth);
    var hosts = c.Applications.Where(a => a.Host != null).Select(a => a.Host!).DistinctBy(h => h.Id).ToList();
    ViewData["Title"] = $"{c.Title} – case {c.Reference}";
}
@section BeforeContent {
    <a href="/Cases" class="govuk-back-link">Back to cases</a>
}
<span class="govuk-caption-l">Case @c.Reference</span>
<h1 class="govuk-heading-l">@c.Title</h1>

<dl class="govuk-summary-list govuk-!-margin-bottom-9">
    <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">Status</dt><dd class="govuk-summary-list__value"><partial name="_CaseStatusTag" model="c.Status" /></dd></div>
    <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">Council</dt><dd class="govuk-summary-list__value">@Display.Council(c.Council)</dd></div>
    <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">Sponsor</dt>
        <dd class="govuk-summary-list__value">
            @if (c.Sponsor is { } s) { <a class="govuk-link" href="/People/@s.Id">@s.FullName</a> } else { @:Not given
            }
        </dd>
    </div>
    <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">Host@(hosts.Count > 1 ? "s" : "")</dt>
        <dd class="govuk-summary-list__value">
            @if (hosts.Count == 0) { @:Not given
            }
            else
            {
                <ul class="govuk-list">
                    @foreach (var h in hosts) { <li><a class="govuk-link" href="/People/@h.Id">@h.FullName</a></li> }
                </ul>
            }
        </dd>
    </div>
    <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">Accommodation</dt>
        <dd class="govuk-summary-list__value">
            @if (c.Accommodation is { } a) { <a class="govuk-link" href="/Accommodations/@a.Id">@a.Address</a>@(string.IsNullOrEmpty(a.Postcode) ? "" : $", {a.Postcode}") } else { @:Not given
            }
        </dd>
    </div>
    <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">People</dt><dd class="govuk-summary-list__value">@guests.Count</dd></div>
    <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">Youngest guest</dt>
        <dd class="govuk-summary-list__value">
            @if (youngest is null) { @:Not given
            }
            else
            {
                <a class="govuk-link" href="/Guests/@youngest.Id">@youngest.FullName</a>@:, aged @Ages.On(youngest.DateOfBirth!.Value, Model.Today) (born @Display.Date(youngest.DateOfBirth))
            }
        </dd>
    </div>
</dl>

<h2 class="govuk-heading-m">Guests (@guests.Count)</h2>
<div class="app-table-wrapper" tabindex="0" role="region" aria-labelledby="case-guests-caption">
<table class="govuk-table">
    <caption id="case-guests-caption" class="govuk-table__caption govuk-visually-hidden">Guests on this case</caption>
    <thead class="govuk-table__head">
        <tr class="govuk-table__row">
            <th scope="col" class="govuk-table__header">Name</th>
            <th scope="col" class="govuk-table__header">Date of birth</th>
            <th scope="col" class="govuk-table__header govuk-table__header--numeric">Age</th>
            <th scope="col" class="govuk-table__header">On the application as</th>
            <th scope="col" class="govuk-table__header">Visa status</th>
        </tr>
    </thead>
    <tbody class="govuk-table__body">
        @foreach (var g in guests)
        {
            <tr class="govuk-table__row">
                <td class="govuk-table__cell"><a class="govuk-link" href="/Guests/@g.Id">@g.FullName</a></td>
                <td class="govuk-table__cell">@Display.Date(g.DateOfBirth)</td>
                <td class="govuk-table__cell govuk-table__cell--numeric">@Display.Age(g.DateOfBirth, Model.Today)</td>
                <td class="govuk-table__cell">@(g.IsLead ? "Lead applicant" : "Family member")</td>
                <td class="govuk-table__cell"><partial name="_VisaStatusTag" model="g.VisaApplication!.Status" /></td>
            </tr>
        }
    </tbody>
</table>
</div>

<h2 class="govuk-heading-m">Visa applications (@c.Applications.Count)</h2>
<ul class="govuk-list">
    @foreach (var app in c.Applications.OrderBy(a => a.SubmittedAt).ThenBy(a => a.Id))
    {
        <li><a class="govuk-link" href="/Applications/@app.Id">@app.Uan</a> – @app.Lead?.FullName, submitted @Display.DateTime(app.SubmittedAt) <partial name="_VisaStatusTag" model="app.Status" /></li>
    }
</ul>
